{
  "name": "trendloom-instagram-downloader",
  "version": "4.12.16",
  "description": "Download Instagram photos, videos, carousel media, Stories and Highlights.",
  "main": "src/js/background.js",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "dev:reload": "npm run dev & node scripts/reload-extension.js",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "lint": "eslint src/js/background.js src/js/bulk-history.js src/js/utils/*.js src/tests/*.js",
    "lint:fix": "eslint src/js/background.js src/js/bulk-history.js src/js/utils/*.js src/tests/*.js --fix",
    "format": "prettier --write src/js/background.js src/js/bulk-history.js src/js/utils/*.js src/tests/*.js",
    "format:check": "prettier --check src/js/background.js src/js/bulk-history.js src/js/utils/*.js src/tests/*.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules",
    "zip": "npm run build && cd dist && zip -r trendloom-instagram-downloader.zip . -x 'trendloom-instagram-downloader.zip' '*.map'"
  },
  "keywords": [
    "instagram",
    "downloader",
    "chrome-extension",
    "browser-extension",
    "media-download"
  ],
  "author": "TrendLoom",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@types/chrome": "^0.0.268",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.10.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.8.1",
    "prettier": "^3.2.5",
    "sass": "^1.71.1",
    "sass-loader": "^14.1.1",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
