{
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "css": [
        "css/extension.css"
      ],
      "js": [
        "js/extension.js",
        "js/bulk-history.js"
      ],
      "matches": [
        "*://*.instagram.com/*"
      ]
    },
    {
      "js": [
        "js/inject.js"
      ],
      "matches": [
        "*://*.instagram.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": [
        "js/options_listener_inject.js"
      ],
      "matches": [
        "*://*.instagram.com/*"
      ],
      "run_at": "document_start"
    }
  ],
  "description": "Download Instagram photos, videos, carousel media, Stories and Highlights.",
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.cdninstagram.net/*",
    "*://*.fbcdn.net/*"
  ],
  "icons": {
    "16": "icons/trendloom-16.png",
    "32": "icons/trendloom-32.png",
    "48": "icons/trendloom-48.png",
    "128": "icons/trendloom-logo-128.png"
  },
  "manifest_version": 3,
  "name": "TrendLoom Instagram Downloader",
  "options_page": "options.html",
  "permissions": [
    "storage"
  ],
  "version": "4.12.16",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "*://*/*"
      ],
      "resources": [
        "icons/download_all_black.svg",
        "icons/download_all_white.svg",
        "icons/download_black.svg",
        "icons/download_white.svg",
        "icons/close_black_24dp.svg",
        "icons/trendloom-logo.png"
      ]
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "resources": [
        "js/options.js",
        "css/options.css"
      ]
    }
  ]
}
